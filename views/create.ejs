<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="mt-4 bg-black">
    <div class="container fixed-md-container">
        <%- include('partials/navbar') %>
        <section class="container-md mt-4">
            <form action="/blogs" method="POST">
                <input type="text" name="title" placeholder="Title" class="form-control bg-black text-white border-0 border-bottom rounded-0 fs-4 mb-3" required autofocus/>

                <textarea name="content"
                    placeholder="Write your blog..." class="form-control bg-black text-white border-0 rounded-0" rows="18" required></textarea>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span>
                        <button class="btn btn-light px-4">
                            Publish
                        </button>
                        <a href="/blog"><span class="text-white ms-4 text-decoration-underline">Back</span></a>
                    </span>

                    <span class="text-secondary small">
                        Markdown supported
                    </span>
                </div>

            </form> 
        </section>

        <%- include('partials/footer') %>
    </div>
</body>
</html>