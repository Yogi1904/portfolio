<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="mt-4 bg-black">
    <div class="container fixed-md-container">
        <%- include('partials/navbar') %>
        <div class="body pb-3">
            <% blogs.forEach(blog => { %>
                <a href="/blogs/<%= blog.id %>" class="text-decoration-none">
                    <p class="d-flex align-items-center my-3">
                        <span class="text-white-50"><%= blog.date %></span>
                        <span class="ms-3 text-white"><%= blog.title %></span>
                    </p>
                </a>
            <% }) %>
        </div>
        <%- include('partials/footer') %>
    </div>
</body>
</html>